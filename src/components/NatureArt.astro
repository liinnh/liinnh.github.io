---
// A calm dusk scene. Light mode = sunset; dark mode = night sky.
// Pass content into the default slot to overlay it on the scene.
const starCount = 60;
// Deterministic pseudo-random so the layout is stable between builds.
const stars = Array.from({ length: starCount }, (_, i) => {
  const a = (i * 73 + 13) % 100;
  const b = (i * 37 + 7) % 100;
  const c = (i * 17 + 3) % 100;
  return {
    id: i,
    top: (a * 0.6).toFixed(1) + "%", // upper portion of the sky
    left: b + "%",
    size: (1 + (c % 3) * 0.6).toFixed(1),
    opacity: (0.35 + (c % 5) * 0.12).toFixed(2),
    delay: (c % 7) * 0.5,
  };
});
---

<div class="hero">
  <div class="sky">
    <div class="stars">
      {
        stars.map((s) => (
          <span
            class="star"
            style={`top:${s.top};left:${s.left};width:${s.size}px;height:${s.size}px;opacity:${s.opacity};animation-delay:${s.delay}s`}
          />
        ))
      }
    </div>

    <div class="celestial"></div>
    <div class="haze"></div>

    <svg class="ridge ridge-3" viewBox="0 0 700 200" preserveAspectRatio="none">
      <path d="M0,70 C120,30 220,60 320,55 C440,48 540,90 700,60 L700,200 L0,200 Z"
      ></path>
    </svg>
    <svg class="ridge ridge-2" viewBox="0 0 700 200" preserveAspectRatio="none">
      <path
        d="M0,120 C90,90 180,110 280,100 C400,88 520,130 620,115 C660,109 690,118 700,120 L700,200 L0,200 Z"
      ></path>
    </svg>
    <svg class="ridge ridge-1" viewBox="0 0 700 200" preserveAspectRatio="none">
      <path
        d="M0,160 C120,135 200,165 320,150 C440,135 540,170 700,150 L700,200 L0,200 Z"
      ></path>
    </svg>
  </div>

  <div class="scrim"></div>
  <div class="overlay"><slot /></div>
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 360px;
    overflow: hidden;
    border-radius: 1.5rem;
    margin: 1.5rem 0 2.5rem;
    border: 1px solid var(--border);
    box-shadow: 0 20px 50px -28px rgba(74, 49, 60, 0.5);
  }
  html.dark .hero {
    box-shadow: 0 20px 50px -24px rgba(0, 0, 0, 0.75);
  }

  .sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #4a5a93 0%,
      #7d6fa6 24%,
      #b27f97 46%,
      #df9a78 68%,
      #efb079 84%,
      #f6c98e 100%
    );
    transition: background 0.8s ease;
  }
  html.dark .sky {
    background: linear-gradient(
      to bottom,
      #090d1c 0%,
      #111830 42%,
      #1a2340 72%,
      #232f54 100%
    );
  }

  /* Sun (light) / moon (dark) */
  .celestial {
    position: absolute;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    right: 16%;
    top: 46%;
    background: radial-gradient(circle at 50% 50%, #fff6e0 0%, #ffd98a 70%, #ffc46a 100%);
    box-shadow: 0 0 60px 20px rgba(255, 211, 130, 0.55),
      0 0 140px 60px rgba(255, 180, 120, 0.35);
    animation: breathe 7s ease-in-out infinite;
    transition: background 0.8s ease, box-shadow 0.8s ease, top 0.8s ease;
  }
  html.dark .celestial {
    top: 22%;
    background: radial-gradient(circle at 38% 38%, #ffffff 0%, #e8ecff 60%, #c9d2f0 100%);
    box-shadow: 0 0 40px 8px rgba(220, 228, 255, 0.45),
      0 0 90px 30px rgba(180, 195, 255, 0.18);
  }

  /* Soft atmospheric band along the horizon */
  .haze {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 55%;
    background: linear-gradient(
      to top,
      rgba(255, 220, 170, 0.45) 0%,
      rgba(255, 210, 170, 0.18) 35%,
      transparent 100%
    );
    pointer-events: none;
    transition: opacity 0.8s ease;
  }
  html.dark .haze {
    background: linear-gradient(
      to top,
      rgba(120, 140, 210, 0.22) 0%,
      transparent 70%
    );
  }

  .stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  html.dark .stars {
    opacity: 1;
  }
  .star {
    position: absolute;
    background: #fff;
    border-radius: 50%;
    animation: twinkle 4.5s ease-in-out infinite;
  }

  /* Receding ridgelines — hazier/lighter in the distance, darker up front */
  .ridge {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 75%;
    pointer-events: none;
  }
  .ridge path {
    transition: fill 0.8s ease;
  }
  .ridge-3 path {
    fill: #c98f9e;
  }
  .ridge-2 path {
    fill: #9d6f86;
  }
  .ridge-1 path {
    fill: #6e4d63;
  }
  html.dark .ridge-3 path {
    fill: #2b3658;
  }
  html.dark .ridge-2 path {
    fill: #1d2742;
  }
  html.dark .ridge-1 path {
    fill: #121829;
  }

  /* Legibility scrim behind overlaid text */
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(40, 24, 36, 0.6) 0%,
      rgba(40, 24, 36, 0.12) 38%,
      transparent 62%
    );
    pointer-events: none;
  }

  .overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.75rem 2rem;
  }

  @keyframes breathe {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-6px) scale(1.015);
    }
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .celestial,
    .star {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      height: 260px;
      border-radius: 1.25rem;
    }
    .celestial {
      width: 60px;
      height: 60px;
    }
    .overlay {
      padding: 1.25rem 1.25rem;
    }
  }
</style>
