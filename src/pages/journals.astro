---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Linh Nguyen">
  <div class="max-w-4xl mx-auto pt-8 pb-16">
    <h1 class="text-4xl font-bold mb-8 text-gray-900 dark:text-white">
      Journals
    </h1>
    <p class="text-lg mb-8 text-gray-700 dark:text-gray-300">
      I've kept a fairly consistent biweekly journaling practice since I was 15.
      Occasionally, I share one-off entries with friends. Some are thoughts on
      life events. Some are reflections on things I've been reading. Some are
      excerpts from the "commonplace book" section of my journal - a collection
      of quotes, ideas, or poems that resonate.
    </p>
    <p class="text-lg mb-8 text-gray-700 dark:text-gray-300">
      Certain (less personal) entries come up more often, so I'm compiling them
      here for easy sharing.
    </p>
    <div class="space-y-8">
      <div>
        <a
          href="/journal/case-against-travel"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >The Case Against Travel</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">March 13, 2024</p>
      </div>
      <div>
        <a
          href="/journal/crack-playlist"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >Crack Playlist</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">April 30, 2021</p>
      </div>
      <div>
        <a
          href="/journal/on-guitar"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >On Guitar</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">August 27, 2020</p>
      </div>
      <div>
        <a
          href="/journal/language-myths"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >Language Myths</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">February 20, 2020</p>
      </div>
      <div>
        <a
          href="/journal/dfw-quotes"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >DFW Quotes</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">December 27, 2018</p>
      </div>
      <div>
        <a
          href="/journal/whatever-you-wanna-do"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >Whatever You Wanna Do</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">July 7, 2017</p>
      </div>
      <div>
        <a
          href="/journal/middlemarch"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >Middlemarch</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">September 16, 2016</p>
      </div>
      <div>
        <a
          href="/journal/brave-new-world"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >Brave New World</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">May 2, 2012</p>
      </div>
    </div>
  </div>
</Layout>
