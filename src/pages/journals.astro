---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Linh Nguyen">
  <div class="max-w-4xl mx-auto pt-8">
    <h1 class="text-4xl font-bold mb-8 text-gray-900 dark:text-white">
      Journals
    </h1>
    <p class="text-lg mb-8 text-gray-700 dark:text-gray-300">
      I've kept a fairly consistent biweekly journaling practice since I was 15.
      Occasionally, I share less personal, one-off entries with friends. Some
      are thoughts on recent life events. Some are reflections on things I've
      been reading. Some are excerpts from the "commonplace book" section of my
      journal - a collection of quotes, ideas, or poems that resonate.
    </p>
    <p class="text-lg mb-8 text-gray-700 dark:text-gray-300">
      Certain entries come up more often, so I'm compiling them here for easy
      sharing.
    </p>
    <div class="space-y-8">
      <div>
        <a
          href="/journal/language-myths"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >Language Myths</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">February 20, 2020</p>
      </div>

      <div>
        <a
          href="/journal/dfw-quotes"
          class="text-2xl font-bold text-gray-900 dark:text-white hover:underline"
          >DFW Quotes</a
        >
        <p class="text-gray-600 dark:text-gray-400 mt-1">December 27, 2018</p>
      </div>
    </div>
  </div>
</Layout>
