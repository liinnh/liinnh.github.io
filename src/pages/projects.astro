---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Linh Nguyen">
  <div class="max-w-4xl mx-auto pt-8">
    <h1 class="text-4xl font-bold mb-8 text-gray-600 dark:text-gray-300">
      Projects
    </h1>
    <div class="space-y-6">
      <!-- Project Card 1 -->
      <div
        class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow"
      >
        <div class="flex justify-between items-start">
          <div>
            <h2
              class="text-2xl font-bold mb-2 text-gray-600 dark:text-gray-300"
            >
              Sleeping with Friends
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A sleep leaderboard that connects to Whoop, Fitbit, Pixel Watch,
              and Garmin. This app is a combination of all my core values:
              friendship, health, and memes. (Please reach out if you have any
              interest in contributing to this project!)
            </p>
          </div>
          <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline"
            >View →</a
          >
        </div>
      </div>

      <!-- Project Card 2 -->
      <div
        class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow"
      >
        <div class="flex justify-between items-start">
          <div>
            <h2
              class="text-2xl font-bold mb-2 text-gray-600 dark:text-gray-300"
            >
              LangGuessr
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A game for improving language identification skills for Geoguessr.
            </p>
          </div>
          <a
            href="https://wikilang-liinnh.pythonanywhere.com/"
            class="text-blue-600 dark:text-blue-400 hover:underline">View →</a
          >
        </div>
      </div>

      <!-- Project Card 3 -->
      <div
        class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow"
      >
        <div class="flex justify-between items-start">
          <div>
            <h2
              class="text-2xl font-bold mb-2 text-gray-600 dark:text-gray-300"
            >
              Cocktail Similarity Network
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Some D3.js experimentation. A graph of cocktail recipes by cosine
              similarity.
            </p>
          </div>
          <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline"
            >View →</a
          >
        </div>
      </div>
    </div>
  </div>
</Layout>
