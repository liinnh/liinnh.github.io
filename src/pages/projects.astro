---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    title: "Sleeping with Friends",
    year: "2024",
    href: "https://www.sleepingwithfriends.com/",
    description:
      "A sleep leaderboard that connects to Whoop, Fitbit, Pixel Watch, and Garmin. This web app is a combination of all my core values: friendship, health, and memes.",
  },
  {
    title: "LangGuessr",
    year: "2022",
    href: "https://langguessr.vercel.app/",
    description:
      "A game for improving language identification skills for Geoguessr.",
  },
  {
    title: "Cocktail Similarity Network",
    year: "2021",
    href: "https://observablehq.com/@liinnh/cocktails-network",
    description:
      "Some D3.js experimentation. A graph of cocktail recipes by cosine similarity.",
  },
];
---

<Layout title="Linh Nguyen">
  <div class="pt-10">
    <h1 class="mb-8">Projects</h1>

    <div class="space-y-5">
      {
        projects.map((p) => (
          <div class="card">
            <div class="flex items-start justify-between gap-4">
              <h2 class="project-title">
                {p.title}<span class="project-year">{p.year}</span>
              </h2>
              <a href={p.href} class="view-link no-underline">
                View →
              </a>
            </div>
            <p class="project-desc">{p.description}</p>
          </div>
        ))
      }
    </div>
  </div>

  <style>
    .project-title {
      font-size: 1.4rem;
      margin: 0;
    }
    .project-year {
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--text-muted);
      margin-left: 0.6rem;
      letter-spacing: 0.02em;
    }
    .view-link {
      color: var(--accent);
      white-space: nowrap;
      flex-shrink: 0;
      font-weight: 500;
      font-size: 0.95rem;
    }
    .view-link:hover {
      color: var(--accent-hover);
    }
    .project-desc {
      color: var(--text);
      margin-top: 0.6rem;
      line-height: 1.65;
    }
  </style>
</Layout>
