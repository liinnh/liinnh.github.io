---
import Layout from "../layouts/Layout.astro";
import NatureArt from "../components/NatureArt.astro";
---

<Layout title="Linh Nguyen">
  <NatureArt>
    <h1 class="hero-name">hi! i'm linh</h1>
  </NatureArt>

  <div class="max-w-2xl text-lg leading-relaxed space-y-6">
    <div>
      <p class="mb-3">I'm based in San Francisco, CA and I love:</p>
      <ul class="love-list">
        <li>data</li>
        <li>
          <a href="https://www.strava.com/athletes/44108651" target="_blank"
            >going outside</a
          >
        </li>
        <li>
          <a href="https://www.last.fm/user/nguyen-linh" target="_blank"
            >listening to</a
          > & <a href="/music">arranging music</a>
        </li>
      </ul>
    </div>

    <p>
      Currently, I'm a data scientist at <a
        href="https://www.exa.ai"
        target="_blank">Exa</a
      >. (We're hiring!) Previously, I built credit underwriting models at <a
        href="https://www.bestegg.com/"
        target="_blank">Best Egg</a
      >.
    </p>

    <p>
      In a past life, I studied at MIT where I majored in Chemical Engineering
      and minored in Music. I also played some <a
        href="https://poker.mit.edu/"
        target="_blank">poker</a
      > and got addicted to <a
        href="https://www.sporcle.com/user/liinnh/"
        target="_blank">Sporcle</a
      > there.
    </p>
  </div>

  <style>
    .hero-name {
      color: #fff;
      font-size: clamp(2.4rem, 6vw, 3.4rem);
      margin: 0;
      text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
    }
    .love-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .love-list li {
      position: relative;
      padding-left: 1.4rem;
    }
    .love-list li + li {
      margin-top: 0.35rem;
    }
    .love-list li::before {
      content: "—";
      position: absolute;
      left: 0;
      color: var(--accent-soft);
    }
  </style>
</Layout>
