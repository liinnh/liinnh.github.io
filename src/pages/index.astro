---
import Layout from "../layouts/Layout.astro";
import NatureArt from "../components/NatureArt.astro";
---

<Layout title="Linh Nguyen">
  <div class="max-w-4xl mx-auto">
    <NatureArt />

    <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-8">
      hi! i'm linh
    </h1>
    <p class="text-m text-gray-700 dark:text-gray-300 mb-8">
      I'm based in San Francisco, CA and I love:
      <ul class="text-m text-gray-700 dark:text-gray-300 mb-8">
        <li>- data</li>
        <li>
          - <a href="https://www.strava.com/athletes/44108651" target="_blank"
            >going outside</a
          >
        </li>
        <li>
          - <a href="https://www.last.fm/user/nguyen-linh" target="_blank"
            >listening to</a
          > & <a href="/music">arranging music</a>
        </li>
      </ul>
    </p>

    <p class="text-m text-gray-700 dark:text-gray-300 mb-8">
      Currently, I'm a data engineer at <a
        href="https://www.exa.ai"
        target="_blank">Exa</a
      >. Previously, I built credit underwriting models at <a
        href="https://www.bestegg.com/"
        target="_blank">Best Egg</a
      >.
    </p>

    <p class="text-m text-gray-700 dark:text-gray-300 mb-8">
      In a past life, I studied at MIT where I majored in Chemical Engineering
      and minored in Music. I also played some <a
        href="https://poker.mit.edu/"
        target="_blank">poker</a
      > and got addicted to <a
        href="https://www.sporcle.com/user/liinnh/"
        target="_blank">Sporcle</a
      > there.
    </p>
  </div>
</Layout>
